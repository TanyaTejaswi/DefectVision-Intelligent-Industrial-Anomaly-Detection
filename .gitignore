# Byte-compiled / optimized / Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Datasets (ignore raw and extracted dataset files, keep directory structure)
datasets/*
!datasets/.gitkeep

# Results and artifacts (ignore generated outputs, keep directory structure)
results/plots/*
!results/plots/.gitkeep
results/metrics/*
!results/metrics/.gitkeep

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

