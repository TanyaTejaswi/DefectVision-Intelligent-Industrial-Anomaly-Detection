# DefectVision Authentication — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# Bootstrap Admin Account (created on first launch if no admin exists)
DEFECTVISION_ADMIN_EMAIL=admin@your-company.com
DEFECTVISION_ADMIN_USERNAME=admin
DEFECTVISION_ADMIN_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Session & Security
DEFECTVISION_SECRET_KEY=generate_with_python_secrets_token_hex_32
DEFECTVISION_SESSION_HOURS=12
DEFECTVISION_REMEMBER_DAYS=30
DEFECTVISION_MAX_FAILED_ATTEMPTS=5
DEFECTVISION_LOCKOUT_MINUTES=15
DEFECTVISION_RESET_TOKEN_HOURS=1

# SMTP (optional — leave blank to use on-screen dev-mode token)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@defectvision.industrial
